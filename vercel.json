{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.posmobile.vn/api/:path*" },
    { "source": "/DXXRDV/:path*", "destination": "https://api.posmobile.vn/DXXRDV/:path*" },
    { "source": "/DXXRD/:path*", "destination": "https://api.posmobile.vn/DXXRD/:path*" },
    { "source": "/((?!api/|DXXRDV|DXXRD|assets/).*)", "destination": "/index.html" }
  ]
}
